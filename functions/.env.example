# Sovik Jewels — Firebase Cloud Functions Environment Variables
# ============================================================
# This file is a TEMPLATE. Copy it to `.env` in this directory
# and fill in your real values. The `.env` file is git-ignored
# and NEVER committed to version control.
#
# The GEMINI_API_KEY is read ONLY on the server-side by the
# Firebase Cloud Function. It is never exposed to the browser.

GEMINI_API_KEY=your_gemini_api_key_here