{
  "name": "sovik-jewels",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bootstrap": "npx --yes tsx scripts/bootstrapFirestore.ts",
    "seed:db": "npx tsx scripts/seedFirestore.ts",
    "deploy:rules": "firebase deploy --only firestore:rules --project sovik-jewels",
    "test:rules": "firebase emulators:exec --only firestore,auth --project sovik-jewels \"node scripts/firestore-rules-emulator-test.mjs\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^10.13.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^11.11.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
