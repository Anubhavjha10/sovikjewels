VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# ── One-time Firestore bootstrap (npm run bootstrap) — server-side only, never exposed to the frontend ──
# Path to the Firebase Admin service-account key used ONLY by scripts/bootstrapFirestore.ts.
# Leave unset to auto-detect scripts/serviceAccountKey.json (gitignored — never commit it).
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/serviceAccountKey.json
# Admin email resolved by the one-time bootstrap (default: sovikjewels@gmail.com)
# BOOTSTRAP_ADMIN_EMAIL=sovikjewels@gmail.com
